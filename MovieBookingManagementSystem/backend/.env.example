# Server Port
PORT=5050
NODE_ENV=production

# PostgreSQL Database Connection String (Neon / Supabase / Render / Railway)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Or Individual PostgreSQL credentials (Alternative):
# DB_NAME=movie_booking
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSL=true

# JWT Secret Key for token signing
JWT_SECRET=cinebook_super_secret_production_jwt_key_2026

# Allowed Frontend URL(s) for CORS (comma separated or * for any)
CORS_ORIGIN=https://your-frontend-app.vercel.app
